{
	"name": "cairn",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest run",
		"test": "npm run test:unit && npm run test:e2e",
		"test:e2e": "playwright install && playwright test",
		"icons": "pwa-assets-generator --preset minimal-2023 static/icon-source.svg",
		"test:watch": "vitest",
		"db:local": "wrangler d1 migrations apply cairn --local",
		"db:remote": "wrangler d1 migrations apply cairn --remote",
		"dev:worker": "wrangler pages dev"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20260811.1",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^24",
		"@vite-pwa/assets-generator": "^1.0.2",
		"@vite-pwa/sveltekit": "^1.1.0",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"fake-indexeddb": "^6.2.5",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vite-plugin-pwa": "^1.3.0",
		"vitest": "^4.1.8",
		"workbox-build": "^7.4.1",
		"workbox-window": "^7.4.1"
	},
	"dependencies": {
		"chrono-node": "^2.10.1",
		"date-fns": "^4.4.0",
		"dexie": "^4.4.4"
	},
	"engines": {
		"node": ">=20.19"
	}
}
