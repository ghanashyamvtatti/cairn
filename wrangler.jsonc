{
	// Cloudflare Workers, serving static assets. There is no Worker script — Cairn is a
	// pure static site with no server, no bindings and no secrets.
	//
	// Why Workers rather than Pages: Cloudflare's build system provisions credentials
	// scoped to the project it created. A Workers project gets a Workers-scoped token, so
	// `wrangler pages deploy` from inside that build fails with
	// `Authentication error [code: 10000]` against /pages/projects/... — which reads like
	// a login problem and is really a wrong-API problem. Static assets on Workers is also
	// where Cloudflare is steering new projects.
	//
	// If this ever moves back to a real Pages project, swap `assets` for
	// `"pages_build_output_dir": "build"` and use `wrangler pages deploy`.
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cairn",
	"compatibility_date": "2026-08-10",
	"assets": {
		"directory": "./build",
		// Every route is prerendered to its own file, so an unknown path really is
		// unknown. `single-page-application` would answer it with the home page under the
		// wrong URL, which is worse than an honest 404.
		"not_found_handling": "none"
	}
}
