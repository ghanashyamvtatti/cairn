{
	// Cloudflare PAGES configuration — not a Worker.
	//
	// Cairn is a pure static site: no Worker, no bindings, no secrets, no server. This
	// file exists so `wrangler pages deploy` needs no flags.
	//
	// CAUTION: Cloudflare's build system sees a wrangler config and may set the project's
	// deploy command to `npx wrangler deploy` — the Workers command. That fails here,
	// because there is no `main` and no `assets` block, and the build log makes it look
	// like a build problem when the build actually succeeded. The deploy command must be
	// `npx wrangler pages deploy`.
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cairn",
	"compatibility_date": "2026-08-10",
	"pages_build_output_dir": "build"
}
